# Composer
/vendor/
composer.lock

# Local configuration & installation state (generated by the installer)
/config/config.php
/config/installed.lock

# Runtime data (keep the directory structure via .gitkeep)
/storage/cache/*
/storage/logs/*
/storage/media/*
/storage/output/*
/storage/preview/*
/storage/uploads/*
/storage/work/*
/storage/database.sqlite
/public/uploads/*
!**/.gitkeep

# Tooling caches
/.phpunit.cache/
/.php-cs-fixer.cache
.phpunit.result.cache

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
